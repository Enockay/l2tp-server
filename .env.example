# L2TP/IPsec VPN Server Configuration

# VPN Server Public IP or Hostname (optional, leave empty to use %any)
# This should be your Collify VPS public IP address
VPN_SERVER_IP=

# VPN Subnet (CIDR notation)
VPN_SUBNET=10.10.10.0/24

# IP Range for VPN clients
VPN_IP_RANGE=10.10.10.2-10.10.10.100

# VPN Server Local IP (gateway IP for clients)
VPN_LOCAL_IP=10.10.10.1

# Pre-Shared Key for IPsec (IMPORTANT: Change this to a strong random key!)
# This key must match on all clients (billing VPS, MikroTik routers)
PSK=YourStrongPreSharedKeyHere123!

# DNS servers for VPN clients
DNS1=8.8.8.8
DNS2=8.8.4.4
